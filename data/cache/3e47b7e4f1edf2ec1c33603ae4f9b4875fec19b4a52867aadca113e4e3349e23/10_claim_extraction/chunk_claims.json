    {
      "chunk_id": "9b580a49750843d68ba1ae78c6a67538_chunk_0013",
      "page": 2,
      "heading_path": "b1_#/texts/26",
      "text": "Document Section: MARQUEE PROJECTS\nContent:\n* Statue of Unity, Gujarat -the world's tallest statue, including its access infrastructure\n* Mumbai Trans Harbour Link (MTHL) -India's longest sea bridge\n* Mumbai -Ahmedabad High-Speed Rail (MAHSR) -civil works including viaducts, stations and river bridges on the C4 package\n* Navi Mumbai International Airport (NMIA)\n* Dhubri -Phulbari Bridge, Assam -Meghalaya -India's longest river bridge, over the Brahmaputra\n* Hyderabad Metro Rail -one of the world's largest metro rail projects executed on a PPP basis\n* Riyadh Metro, Saudi Arabia -systems and integration works",
      "extraction": {
        "chunk_id": "9b580a49750843d68ba1ae78c6a67538_chunk_0013",
        "claims": [
          {
            "claim_id": "9b580a49750843d68ba1ae78c6a67538_chunk_0013_claim_000",
            "text": "Statue of Unity, Gujarat is the world's tallest statue including its access infrastructure.",
            "type": "fact"
          },
          {
            "claim_id": "9b580a49750843d68ba1ae78c6a67538_chunk_0013_claim_001",
            "text": "Mumbai Trans Harbour Link (MTHL) is India's longest sea bridge.",
            "type": "fact"
          },
          {
            "claim_id": "9b580a49750843d68ba1ae78c6a67538_chunk_0013_claim_002",
            "text": "Mumbai-Ahmedabad High-Speed Rail (MAHSR) includes civil works such as viaducts, stations and river bridges on the C4 package.",
            "type": "fact"
          },
          {
            "claim_id": "9b580a49750843d68ba1ae78c6a67538_chunk_0013_claim_003",
            "text": "Navi Mumbai International Airport (NMIA) is mentioned.",
            "type": "fact"
          },
          {
            "claim_id": "9b580a49750843d68ba1ae78c6a67538_chunk_0013_claim_004",
            "text": "Dhubri-Phulbari Bridge, Assam-Meghalaya is India's longest river bridge over the Brahmaputra.",
            "type": "fact"
          },
          {
            "claim_id": "9b580a49750843d68ba1ae78c6a67538_chunk_0013_claim_005",
            "text": "Hyderabad Metro Rail is one of the world's largest metro rail projects executed on a PPP basis.",
            "type": "fact"
          },
          {
            "claim_id": "9b580a49750843d68ba1ae78c6a67538_chunk_0013_claim_006",
            "text": "Riyadh Metro, Saudi Arabia includes systems and integration works.",
            "type": "fact"
          }
        ],
        "entities": [
          {
            "entity_id": "9b580a49750843d68ba1ae78c6a67538_chunk_0013_ent_000",
            "text": "Statue of Unity, Gujarat",
            "type": "Project"
          },
          {
