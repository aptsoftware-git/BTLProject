{
  "policies": [
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0001_ob_000",
      "text": "If in doubt, check with there reporting manager before acting on any policy below.",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0001"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0004_pol_000",
      "text": "to help organizations unlock the value trapped in their documents by combining rigorous engineering with respect for the people who rely on our software everyday.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0004"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0004_pol_001",
      "text": "a future in which no employee ever has to manually search hundreds of pages to find a single fact.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0004"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0005_pol_000",
      "text": "Customer Obsession -we start with the customer's problem.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0005"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0005_pol_001",
      "text": "Ownership -every employee fixes what they see is broken.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0005"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0005_pol_002",
      "text": "Integrity -we do the right thing even when its inconvenient.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0005"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0005_pol_003",
      "text": "Curiosity -we treat contradictions as learning opportunities.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0005"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0007_pol_000",
      "text": "Human Resources Policies",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0007"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0008_pol_000",
      "text": "2.1 Leave Policy",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0008"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0008_pol_001",
      "text": "2.2 Attendance",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0008"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0008_pol_002",
      "text": "2.3 Code of Conduct",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0008"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0009_pol_000",
      "text": "Employees receive 18 annual leaves per calendar year, credited pro-rata for employees joining mid-year, plus 10 sick and 5 casual leaves.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0009"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0009_pol_001",
      "text": "Employees receive 20 annual leaves per calendar year following the FY23 revision.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0009"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0009_pol_002",
      "text": "Standard hours are 9:30 AM -6:30 PM.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0009"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0009_pol_003",
      "text": "Employees who's conduct violates the Code of Conduct may face disciplinary action; their are no exceptions based on seniority.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0009"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0009_perm_000",
      "text": "Employees receive 18 annual leaves per calendar year, credited pro-rata for employees joining mid-year, plus 10 sick and 5 casual leaves.",
      "type": "permission",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0009"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0009_perm_001",
      "text": "Employees receive 20 annual leaves per calendar year following the FY23 revision.",
      "type": "permission",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0009"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0010_pol_000",
      "text": "Work From Home",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0010"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0011_pol_000",
      "text": "Employees may work remotely three days every week, subject to manager approval.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0011"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0011_pol_001",
      "text": "Employees are expected to work from office full time, effective the date communicated by department heads.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0011"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0011_ob_000",
      "text": "Employees are expected to work from office full time, effective the date communicated by department heads.",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0011"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0011_perm_000",
      "text": "Employees may work remotely three days every week, subject to manager approval.",
      "type": "permission",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0011"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0012_pol_000",
      "text": "Travel Policy",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0012"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0013_pol_000",
      "text": "Travel should be approved whenever necessary.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0013"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0013_pol_001",
      "text": "International travel needs ~4 weeks lead time for visa processing.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0013"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0013_pol_002",
      "text": "Travel insurance is mandatory.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0013"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0013_pol_003",
      "text": "Employees below a certain grade may need additional sign-off.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0013"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0013_ob_000",
      "text": "Travel insurance is mandatory.",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0013"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0013_perm_000",
      "text": "Employees below a certain grade may need additional sign-off.",
      "type": "permission",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0013"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0015_pol_000",
      "text": "Password Policy",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0015"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0015_pol_001",
      "text": "MFA",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0015"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0015_pol_002",
      "text": "VPN",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0015"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0015_pol_003",
      "text": "Device Encryption",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0015"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0015_pol_004",
      "text": "USB Policy",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0015"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016_pol_000",
      "text": "Passwords are atleast 12 characters, mixed case + numeric + special, and rotated every 90 days.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016_pol_001",
      "text": "MFA is mandatory for email, VPN, and internal apps within 48 hours of access being granted.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016_pol_002",
      "text": "VPN required for all off-network access; split tunneling disabled by default.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016_pol_003",
      "text": "Full-disk encryption mandatory on all company laptops.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016_ob_000",
      "text": "Passwords are mandatory to be atleast 12 characters, mixed case + numeric + special, and rotated every 90 days.",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016_ob_001",
      "text": "MFA is mandatory for email, VPN, and internal apps within 48 hours of access being granted.",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016_ob_002",
      "text": "VPN is required for all off-network access.",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016_ob_003",
      "text": "Full-disk encryption is mandatory on all company laptops.",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016_ob_004",
      "text": "Personal USB drives are prohibited unless approved by IT Security.",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0016"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0017_pol_000",
      "text": "Password Policy",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0017"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0017_pol_001",
      "text": "MFA",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0017"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0017_pol_002",
      "text": "VPN",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0017"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0017_pol_003",
      "text": "Device Encryption",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0017"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0017_pol_004",
      "text": "USB Policy",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0017"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0027_ob_000",
      "text": "Standard SLA is first response within 4 business hours for Tier 1 tickets.",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0027"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0029_ob_000",
      "text": "Vertexa's data protection obligations are summarized here",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0029"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0031_ob_000",
      "text": "critical systems must be restored within 4 hours of a declared incident.",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0031"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0037_ob_000",
      "text": "Raise a purchase requisition in the procurement portal.",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0037"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0037_ob_001",
      "text": "Obtain budget sign-off from the department head.",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0037"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0037_ob_002",
      "text": "Finance issues a purchase order to the approved vendor.",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0037"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0037_ob_003",
      "text": "Goods/services are received and matched against the PO before payment.",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0037"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0041_pol_000",
      "text": "Health insurance coverage begins after 30 days of continuous employment.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0041"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0041_pol_001",
      "text": "Health insurance coverage begins after 90 days of continuous employment.",
      "type": "policy",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0041"
    },
    {
      "policy_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0047_ob_000",
      "text": "MFA is mandatory for all employees",
      "type": "obligation",
      "chunk_id": "a8619fd4ae194817a13dad90f43659f8_chunk_0047"
    }
  ]
}