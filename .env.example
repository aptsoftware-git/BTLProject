# Claude
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-7-sonnet

# Tavily
TAVILY_API_KEY=your_tavily_api_key_here

# Ollama
OLLAMA_HOST=http://localhost:11434
# qwen2.5:32b assumes GPU-backed inference. On a CPU-only host, a 32B model
# is impractical (minutes per generation) -- use a small instruct model
# instead, e.g.:
#   OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_MODEL=qwen2.5:32b

# Comparative Analysis local-LLM fallback: model used (on the same
# OLLAMA_HOST above) ONLY when the Claude API is unavailable -- missing/
# invalid CLAUDE_API_KEY, out of credits, rate-limited, or a network failure
# -- so the Executive Comparative Analysis report still comes from a real
# LLM synthesis of this document's actual data instead of a generic
# template. Must be a model already pulled on that Ollama host.
ALTERNATIVE_COMPARATIVE_ANALYSIS_MODEL=qwen2.5-coder:32b

# --- CPU-only performance tuning (all optional, safe defaults above) ---
# Per-request Ollama timeout. Raise this on CPU-only hosts -- the default
# batched grammar-review prompt can legitimately take minutes to generate
# on CPU, and hitting a too-short timeout triggers a retry + a slower
# per-paragraph fallback loop that multiplies total wall-clock time.
# OLLAMA_TIMEOUT_SECONDS=180
# CPU threads Ollama uses per generation. Defaults to all logical cores.
# OLLAMA_NUM_THREAD=8
# Thread-pool worker count for the Context Analysis (Stage 6) sub-pipelines.
# On a CPU-only, single-instance Ollama server, a high worker count doesn't
# parallelize actual inference (Ollama serializes on one CPU worker) -- it
# just queues requests. Lower this to 1-2 on CPU-only hosts.
# CONTEXT_MAX_WORKERS=8
# Chunks bundled per LLM call during chunk-level ambiguity analysis. Smaller
# batches mean smaller prompts and faster per-call CPU inference.
# CONTEXT_CHUNK_BATCH_SIZE=10